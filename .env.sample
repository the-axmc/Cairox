# Starknet network
STARKNET_NETWORK=sepolia
# Public Sepolia RPC (set your provider URL)
STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_8/REPLACE_ME
# Middleware API base for frontend builds
VITE_MIDDLEWARE_URL=http://localhost:8787
# Frontend on-chain helpers
VITE_USDC_ADDRESS=0x...
VITE_COLLATERAL_VAULT_ADDRESS=0x...
# Optional override for chain id as felt (default derived from STARKNET_NETWORK)
STARKNET_CHAIN_ID=SN_SEPOLIA

# Account (signing)
# Production: use a keystore + external signer, avoid raw private keys in env.
STARKNET_ACCOUNT_ADDRESS=0x...
STARKLI_ACCOUNT=~/.starkli-wallets/deployer/account.json
STARKLI_KEYSTORE=~/.starkli-wallets/deployer/keystore.json
# Allow passing keystore password via env only for dev/testing.
STARKLI_ALLOW_PASSWORD_ENV=0
STARKNET_KEYSTORE_PASSWORD=

# Deployment keys (contracts/config.json)
DEPLOYER_ACCOUNT=0x...
# DEV ONLY (do not use in production)
DEPLOYER_PRIVATE_KEY=0x...
DEVNET_PRIVATE_KEY=0x...
DUMMY_CLASS_HASH=0x...
CAIROX_CLASS_HASH=0x...

# Deployed contract addresses
# Use scripts/merge_env.py to sync from config/addresses.sepolia.json
ORACLE_CONTRACT_ADDRESS=0x...
RESOLUTION_VERIFIER_ADDRESS=0x...
ZK_VERIFIER_ADDRESS=0x...
DATA_COMMITMENT_ADDRESS=0x...
PRICE_ORACLE_ADDRESS=0x...
ORACLE_PROPOSER_BOND=100
ORACLE_REQUIRE_SIGNED=1
ORACLE_SIGNER_PUBLIC_KEY=0x...
# DEV ONLY (use HSM or remote signer in production)
ORACLE_SIGNER_PRIVATE_KEY=0x...
ORACLE_ZK_PROOF_PATH=
ORACLE_ZK_PROOF_DIR=
ORACLE_ZK_PUBLIC_INPUTS_PATH=
ORACLE_COMMIT_MARKET_STATE=0
ORACLE_MARKET_ADDRESS=0x...
# JSON map of market_id -> address
ORACLE_MARKET_ADDRESSES_JSON=
# JSON object: {"yes_supply": "...", "no_supply": "...", "b_param": "...", "price_yes": "...", "price_no": "...", "timestamp": 0}
ORACLE_MARKET_STATE_JSON=
CALCULATOR_CONTRACT_ADDRESS=0x...
MARKET_FACTORY_ADDRESS=0x...
SHIELDED_POOL_ADDRESS=0x...
SHIELDED_POOL_VERIFIER=0x...

# Stablecoin (Cairox EUR) - collateralized mint/redeem
# Stablecoin (optional - not used in v1 privacy mode)
STABLECOIN_NAME=Cairox USD
STABLECOIN_SYMBOL=cUSD
STABLECOIN_DECIMALS=6
STABLECOIN_OWNER=0x...
STABLECOIN_COLLATERAL_TOKEN=0x...
STABLECOIN_COLLATERAL_DECIMALS=6
STABLECOIN_PRICE_FEED=0x...
STABLECOIN_PRICE_FEED_TYPE=1
STABLECOIN_TOKEN_ADDRESS=0x...
CHAINLINK_EUR_USD_FEED=0x...
EUR_PRICE_ORACLE_ADDRESS=0x...
INITIAL_SUBSIDY=1000000

# Collateral + bonds (use the stablecoin)
COLLATERAL_TOKEN_ADDRESS=0x... # USDC for v1 privacy
CAIROX_TOKEN_ADDRESS=0x...
BOND_TOKEN_ADDRESS=0x...
USDC_ADDRESS=0x...
COLLATERAL_VAULT_ADDRESS=0x...

# Testnet helper scripts
ORACLE_ADDRESS_TESTNET=0x...
MARKET_FACTORY_ADDRESS_TESTNET=0x...
COLLATERAL_VAULT_ADDRESS_TESTNET=0x...
STABLECOIN_ADDRESS_TESTNET=0x...
USDC_ADDRESS_TESTNET=0x...

# Oracle feeder bot
ORACLE_ADDRESS=0x...
WALLET_ADDRESS=0x...
# DEV ONLY (oracle feeder bot)
PRIVATE_KEY=0x...

# Middleware hardening
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=1
MIDDLEWARE_RATE_LIMIT_WINDOW_MS=60000
MIDDLEWARE_RATE_LIMIT_MAX=240
MARKETS_CACHE_TTL_MS=10000
RPC_TIMEOUT_MS=10000
RELAYER_TIMEOUT_MS=120000
# Simple local flow (recommended for local UI/API bring-up)
# 1 = local/spec-backed simulation, 0 = full relayer/RPC flow
MIDDLEWARE_SIMPLE_FLOW=1
SIMPLE_FLOW_DECIMALS=6
# Returned by /api/vault_balance in simple mode to skip wallet funding calls
SIMPLE_FLOW_VAULT_BALANCE=1000000000000
GROWTHEPIE_BASE_URL=https://api.growthepie.com
GROWTHEPIE_TIMEOUT_MS=12000
MARKET_TIMEZONE=Europe/Berlin
DAILY_MARKET_SNAPSHOT_PATH=middleware/data/daily_market_snapshots.json

# Relayer (deposit proofs + transact)
RELAYER_URL=http://localhost:8788
RELAYER_BALANCE_PATH=/balance
RELAYER_DEPOSIT_PATH=/deposit
RELAYER_TRADE_PATH=/trade
RELAYER_WITHDRAW_PATH=/withdraw
RELAYER_VAULT_PATH=/vault_balance
RELAYER_API_KEY=change-me
RELAYER_REQUIRE_API_KEY=0
RELAYER_ENABLE_DEBUG_ROUTES=0
RELAYER_RATE_LIMIT_WINDOW_MS=60000
RELAYER_RATE_LIMIT_MAX=120
RELAYER_FEE_LOW=1000
RELAYER_FEE_HIGH=0
RELAYER_AMOUNT_DECIMALS=6
RELAYER_AMOUNT_IN_BASE_UNITS=0
RELAYER_ALLOW_RESET=0
